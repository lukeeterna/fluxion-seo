---
import Base from '../layouts/Base.astro';
import { pages } from '../data/locations.ts';
---
<Base
  title="FLUXION — Gestionale desktop per PMI italiane | €497 una tantum"
  description="FLUXION: agenda, promemoria WhatsApp e receptionist vocale AI per saloni e attività locali. Una tantum, nessun abbonamento."
  path="/"
>
  <main id="main" class="section">
    <div class="wrap">
      <span class="eyebrow">FLUXION</span>
      <h1 style="font-size:var(--fs-h2);margin-top:var(--s-2)">Gestionale desktop per PMI italiane</h1>
      <p class="lead" style="margin-top:var(--s-2)">Scopri FLUXION per il tuo settore e la tua città.</p>
      <ul style="margin-top:var(--s-3);line-height:2.2">
        {pages.map((p) => (
          <li><a class="hl" style="font-weight:700" href={`/${p.slug}/`}>{p.verticaleLabel} a {p.citta}</a></li>
        ))}
      </ul>
    </div>
  </main>
</Base>
